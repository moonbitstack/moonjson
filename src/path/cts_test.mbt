    "whitespace, slice, space between colon and end", "$[1: 5:2]", "[1,2,3,4,5,6]",
    "[[2,4]]",
  ),
  (
    "whitespace, slice, newline between colon and end", "$[1:\n5:2]", "[1,2,3,4,5,6]",
    "[[2,4]]",
  ),
  (
    "whitespace, slice, tab between colon and end", "$[1:\t5:2]", "[1,2,3,4,5,6]",
    "[[2,4]]",
  ),
  (
    "whitespace, slice, return between colon and end", "$[1:\r5:2]", "[1,2,3,4,5,6]",
    "[[2,4]]",
  ),
  (
    "whitespace, slice, space between end and colon", "$[1:5 :2]", "[1,2,3,4,5,6]",
    "[[2,4]]",
  ),
  (
    "whitespace, slice, newline between end and colon", "$[1:5\n:2]", "[1,2,3,4,5,6]",
    "[[2,4]]",
  ),
  (
    "whitespace, slice, tab between end and colon", "$[1:5\t:2]", "[1,2,3,4,5,6]",
    "[[2,4]]",
  ),
  (
    "whitespace, slice, return between end and colon", "$[1:5\r:2]", "[1,2,3,4,5,6]",
    "[[2,4]]",
  ),
  (
    "whitespace, slice, space between colon and step", "$[1:5: 2]", "[1,2,3,4,5,6]",
    "[[2,4]]",
  ),
  (
    "whitespace, slice, newline between colon and step", "$[1:5:\n2]", "[1,2,3,4,5,6]",
    "[[2,4]]",
  ),
  (
    "whitespace, slice, tab between colon and step", "$[1:5:\t2]", "[1,2,3,4,5,6]",
    "[[2,4]]",
  ),
  (
    "whitespace, slice, return between colon and step", "$[1:5:\r2]", "[1,2,3,4,5,6]",
    "[[2,4]]",
  ),
]

///|
/// Whether the nodes selected are the ones one of the allowed answers names.
fn answers(got : Array[Json], allowed : Json) -> Bool {
  let candidates = match allowed {
    Array(items) => items
    _ => []
  }
  for candidate in candidates {
    let nodes = match candidate {
      Array(items) => items
      _ => []
    }
    if nodes.length() != got.length() {
      continue
    }
    let mut same = true
    for i in 0..<nodes.length() {
      if !@path.alike(got[i], nodes[i]) {
        same = false
        break
      }
    }
    if same {
      return true
    }
  }
  false
}

///|
test "the RFC 9535 compliance suite" {
  let failures : Array[String] = []
  let mut refused = 0
  let mut selected = 0
  for (name, selector, document, expected) in compliance {
    if document == "" {
      refused += 1
      let accepted = try {
        @path.compile(selector[:]) |> ignore
        true
      } catch {
        _ => false
      }
      if accepted {
        failures.push("\{name}: `\{selector}` was accepted")
      }
      continue
    }
    selected += 1
    let doc = @json.loads(document)
    let got = @path.select(doc, selector[:]) catch {
      _ => {
        failures.push("\{name}: `\{selector}` was refused")
        continue
      }
    }
    if !answers(got, @json.loads(expected)) {
      failures.push(
        "\{name}: `\{selector}` selected \{@json.dumps(Json::array(got))}",
      )
    }
  }
  if failures.length() > 0 {
    for failure in failures {
      println(failure)
    }
    fail("\{failures.length()} of \{compliance.length()} cases failed")
  }
  assert_eq(refused, 249)
  assert_eq(selected, 466)
}
