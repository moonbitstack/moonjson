///|
/// The official JSON5 test corpus, in full: the files json5-tests ships, one
/// case per file, in four kinds.
///
/// A `.json` file is valid JSON and must stay valid JSON5. A `.json5` file uses
/// the dialect's own features and must hold the value the reference
/// implementation holds; the corpus does not carry that value — the reference
/// evaluates the file — so each case was computed once and written out here as
/// a document. A `.js` file is valid ES5 that JSON5 explicitly refuses (an
/// octal number, a leading comma), and a `.txt` or `.errorSpec` file is not
/// valid ES5 either. The last two must be refused.
///
/// The table is generated by `scripts/gen_fixtures.py` from the corpus, which
/// is not in this repository.
let official : Array[(String, String, String, Bool)] = [
  ("arrays/empty-array.json", "[]", "[]", true),
  ("arrays/leading-comma-array.js", "[\n    ,null\n]", "", false),
  ("arrays/lone-trailing-comma-array.js", "[\n    ,\n]", "", false),
  ("arrays/no-comma-array.txt", "[\n    true\n    false\n]", "", false),
  (
    "arrays/regular-array.json", "[\n    true,\n    false,\n    null\n]", "[true,false,null]",
    true,
  ),
  ("arrays/trailing-comma-array.json5", "[\n    null,\n]", "[null]", true),
  (
    "comments/block-comment-following-array-element.json5", "[\n    false\n    /*\n        true\n    */\n]",
    "[false]", true,
  ),
  (
    "comments/block-comment-following-top-level-value.json5", "null\n/*\n    Some non-comment top-level value is needed;\n    we use null above.\n*/",
    "null", true,
  ),
  (
    "comments/block-comment-in-string.json", "\"This /* block comment */ isn't really a block comment.\"",
    "\"This /* block comment */ isn't really a block comment.\"", true,
  ),
  (
    "comments/block-comment-preceding-top-level-value.json5", "/*\n    Some non-comment top-level value is needed;\n    we use null below.\n*/\nnull",
    "null", true,
  ),
  (
    "comments/block-comment-with-asterisks.json5", "/**\n * This is a JavaDoc-like block comment.\n * It contains asterisks inside of it.\n * It might also be closed with multiple asterisks.\n * Like this:\n **/\ntrue",
    "true", true,
  ),
  (
    "comments/inline-comment-following-array-element.json5", "[\n    false   // true\n]",
    "[false]", true,
  ),
  (
    "comments/inline-comment-following-top-level-value.json5", "null // Some non-comment top-level value is needed; we use null here.",
    "null", true,
  ),
  (
    "comments/inline-comment-in-string.json", "\"This inline comment // isn't really an inline comment.\"",
    "\"This inline comment // isn't really an inline comment.\"", true,
  ),
  (
    "comments/inline-comment-preceding-top-level-value.json5", "// Some non-comment top-level value is needed; we use null below.\nnull",
    "null", true,
  ),
  (
    "comments/irregular-block-comment.json", "true\n/*/* This message is inside comment; it is not a nested comment. /*/\n",
    "true", true,
  ),
  (
    "comments/top-level-block-comment.txt", "/*\n    This should fail;\n    comments cannot be the only top-level value.\n*/",
    "", false,
  ),
  (
    "comments/top-level-inline-comment.txt", "// This should fail; comments cannot be the only top-level value.",
    "", false,
  ),
  (
    "comments/unterminated-block-comment.txt", "true\n/*\n    This block comment doesn't terminate.\n    There was a legitimate value before this,\n    but this is still invalid JS/JSON5.\n",
