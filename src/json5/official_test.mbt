  ),
  (
    "strings/multi-line-string.json5", "'hello\\\n world'", "\"hello world\"", true,
  ),
  (
    "strings/single-quoted-string.json5", "'hello world'", "\"hello world\"", true,
  ),
  ("strings/unescaped-multi-line-string.txt", "\"foo\nbar\"\n", "", false),
  (
    "todo/unicode-escaped-unquoted-key.json5", "{\n    sig\\u03A3ma: \"the sum of all things\"\n}",
    "{\"sigΣma\":\"the sum of all things\"}", true,
  ),
  (
    "todo/unicode-unquoted-key.json5", "{\n    ümlåût: \"that's not really an ümlaüt, but this is\"\n}",
    "{\"ümlåût\":\"that's not really an ümlaüt, but this is\"}", true,
  ),
]

///|
/// Whether two documents hold the same value.
///
/// Not `==`: two numbers that were written as integers are compared by their
/// digits, so a twenty-digit integer that a double cannot hold is still the
/// integer it was written as, and a negative zero is not a zero. Everything
/// else is structural, and an object's members are matched by name rather than
/// by the order they were written in.
fn same(a : Json, b : Json) -> Bool {
  match (a, b) {
    (Null, Null) | (True, True) | (False, False) => true
    (String(x), String(y)) => x == y
    (Number(x, ..), Number(y, ..)) => numbers_same(x, repr_of(a), y, repr_of(b))
    (Array(x), Array(y)) => {
      if x.length() != y.length() {
        return false
      }
      for i in 0..<x.length() {
        if !same(x[i], y[i]) {
          return false
        }
      }
      true
    }
    (Object(x), Object(y)) => {
      if x.length() != y.length() {
        return false
      }
      for name, held in x {
        match y.get(name) {
          Some(other) => if !same(held, other) { return false }
          None => return false
        }
      }
      true
    }
    _ => false
  }
}

///|
/// The text a number was written as, when it still has one.
fn repr_of(value : Json) -> String? {
  match value {
    Number(_, repr~) => repr
    _ => None
  }
}

///|
fn numbers_same(
  x : Double,
  left : String?,
  y : Double,
  right : String?,
) -> Bool {
  if x.is_nan() || y.is_nan() {
    return x.is_nan() && y.is_nan()
  }
  match (integer_text(left), integer_text(right)) {
    (Some(a), Some(b)) => a == b
    _ => x.reinterpret_as_uint64() == y.reinterpret_as_uint64()
  }
}

///|
/// The digits of a number that was written as an integer, or `None` when it was
/// written with a point or an exponent.
fn integer_text(repr : String?) -> String? {
  match repr {
    Some(text) => {
      if text.length() == 0 {
        return None
      }
      for i in 0..<text.length() {
        let c = text.at(i).to_int()
        if i == 0 && c == 0x2D && text.length() > 1 {
          continue
        }
        if c < 0x30 || c > 0x39 {
          return None
        }
      }
      Some(text)
    }
    None => None
  }
}

///|
test "the official JSON5 cases" {
  let failures : Array[String] = []
  let mut read = 0
  let mut refused = 0
  for (name, source, expected, valid) in official {
    if valid {
      read += 1
      let got = Some(@json5.loads(source)) catch { _ => None }
      match got {
        None => failures.push("\{name}: refused")
        Some(value) =>
          if !same(value, @json5.loads(expected)) {
            failures.push("\{name}: read as \{@json5.dumps(value)}")
          }
      }
    } else {
      refused += 1
      let accepted = try {
        @json5.loads(source) |> ignore
        true
      } catch {
        _ => false
      }
      if accepted {
        failures.push("\{name}: accepted")
      }
    }
  }
  if failures.length() > 0 {
    for failure in failures {
      println(failure)
    }
    fail("\{failures.length()} of \{official.length()} cases failed")
  }
  // A table that lost rows would still pass every row it kept.
  assert_eq(read + refused, official.length())
  assert_true(read > 0 && refused > 0)
}

///|
/// The three numbers the expectations are written with, read back the way the
/// corpus means them. Without this the table could agree with itself about a
/// value neither it nor the reader understands.
test "the expectations mean what they say" {
  assert_true(same(@json5.loads("NaN"), Json::number(@double.not_a_number)))
  assert_true(same(@json5.loads("Infinity"), Json::number(@double.infinity)))
  assert_true(
    same(@json5.loads("-Infinity"), Json::number(@double.neg_infinity)),
  )
  assert_false(same(@json5.loads("-0"), @json5.loads("0")))
  assert_true(same(@json5.loads("1"), @json5.loads("1.0")))
}
