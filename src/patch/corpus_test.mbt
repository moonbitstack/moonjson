///|
/// The json-patch-tests corpus, in full: the cases every JSON Patch
/// implementation is measured against. Each row is the target document, the
/// patch, and either the document that results or — when the last column says
/// the patch must be refused — nothing.
///
/// The table is generated by `scripts/gen_fixtures.py json-patch` from the
/// corpus, which is not in this repository.
let cases : Array[(String, String, String, String, Bool)] = [
  ("empty list, empty docs", "{}", "[]", "{}", true),
  ("empty patch list", "{\"foo\":1}", "[]", "{\"foo\":1}", true),
  (
    "rearrangements OK?", "{\"foo\":1,\"bar\":2}", "[]", "{\"bar\":2,\"foo\":1}",
    true,
  ),
  (
    "rearrangements OK?  How about one level down ... array", "[{\"foo\":1,\"bar\":2}]",
    "[]", "[{\"bar\":2,\"foo\":1}]", true,
  ),
  (
    "rearrangements OK?  How about one level down...", "{\"foo\":{\"foo\":1,\"bar\":2}}",
    "[]", "{\"foo\":{\"bar\":2,\"foo\":1}}", true,
  ),
  (
    "add replaces any existing field", "{\"foo\":null}", "[{\"op\":\"add\",\"path\":\"/foo\",\"value\":1}]",
    "{\"foo\":1}", true,
  ),
  (
    "toplevel array", "[]", "[{\"op\":\"add\",\"path\":\"/0\",\"value\":\"foo\"}]",
    "[\"foo\"]", true,
  ),
  ("toplevel array, no change", "[\"foo\"]", "[]", "[\"foo\"]", true),
  (
    "toplevel object, numeric string", "{}", "[{\"op\":\"add\",\"path\":\"/foo\",\"value\":\"1\"}]",
    "{\"foo\":\"1\"}", true,
  ),
  (
    "toplevel object, integer", "{}", "[{\"op\":\"add\",\"path\":\"/foo\",\"value\":1}]",
    "{\"foo\":1}", true,
  ),
  (
    "replace object document with array document?", "{}", "[{\"op\":\"add\",\"path\":\"\",\"value\":[]}]",
    "[]", true,
  ),
  (
    "replace array document with object document?", "[]", "[{\"op\":\"add\",\"path\":\"\",\"value\":{}}]",
    "{}", true,
  ),
  (
    "append to root array document?", "[]", "[{\"op\":\"add\",\"path\":\"/-\",\"value\":\"hi\"}]",
    "[\"hi\"]", true,
  ),
  (
    "Add, / target", "{}", "[{\"op\":\"add\",\"path\":\"/\",\"value\":1}]", "{\"\":1}",
    true,
  ),
  (
    "Add, /foo/ deep target (trailing slash)", "{\"foo\":{}}", "[{\"op\":\"add\",\"path\":\"/foo/\",\"value\":1}]",
    "{\"foo\":{\"\":1}}", true,
  ),
  (
    "Add composite value at top level", "{\"foo\":1}", "[{\"op\":\"add\",\"path\":\"/bar\",\"value\":[1,2]}]",
    "{\"bar\":[1,2],\"foo\":1}", true,
  ),
  (
    "Add into composite value", "{\"foo\":1,\"baz\":[{\"qux\":\"hello\"}]}", "[{\"op\":\"add\",\"path\":\"/baz/0/foo\",\"value\":\"world\"}]",
    "{\"baz\":[{\"foo\":\"world\",\"qux\":\"hello\"}],\"foo\":1}", true,
  ),
  (
    "unnamed", "{\"bar\":[1,2]}", "[{\"op\":\"add\",\"path\":\"/bar/8\",\"value\":\"5\"}]",
    "", false,
  ),
  (
    "unnamed", "{\"bar\":[1,2]}", "[{\"op\":\"add\",\"path\":\"/bar/-1\",\"value\":\"5\"}]",
    "", false,
  ),
  (
    "unnamed", "{\"foo\":1}", "[{\"op\":\"add\",\"path\":\"/bar\",\"value\":true}]",
    "{\"bar\":true,\"foo\":1}", true,
  ),
  (
    "unnamed", "{\"foo\":1}", "[{\"op\":\"add\",\"path\":\"/bar\",\"value\":false}]",
    "{\"bar\":false,\"foo\":1}", true,
  ),
  (
    "unnamed", "{\"foo\":1}", "[{\"op\":\"add\",\"path\":\"/bar\",\"value\":null}]",
    "{\"bar\":null,\"foo\":1}", true,
  ),
  (
    "0 can be an array index or object element name", "{\"foo\":1}", "[{\"op\":\"add\",\"path\":\"/0\",\"value\":\"bar\"}]",
    "{\"0\":\"bar\",\"foo\":1}", true,
  ),
  (
    "unnamed", "[\"foo\"]", "[{\"op\":\"add\",\"path\":\"/1\",\"value\":\"bar\"}]",
    "[\"foo\",\"bar\"]", true,
  ),
  (
    "unnamed", "[\"foo\",\"sil\"]", "[{\"op\":\"add\",\"path\":\"/1\",\"value\":\"bar\"}]",
    "[\"foo\",\"bar\",\"sil\"]", true,
  ),
  (
    "unnamed", "[\"foo\",\"sil\"]", "[{\"op\":\"add\",\"path\":\"/0\",\"value\":\"bar\"}]",
