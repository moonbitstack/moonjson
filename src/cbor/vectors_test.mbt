///|
/// Whether two documents hold the same value. Numbers are compared by value
/// rather than by the text they were written as, because a binary format does
/// not keep that text: `1` and `1.0` are one number once they have been
/// encoded, which is the point of encoding them.
fn same(a : Json, b : Json) -> Bool {
  match (a, b) {
    (Null, Null) | (True, True) | (False, False) => true
    (Number(x, ..), Number(y, ..)) => x == y || (x.is_nan() && y.is_nan())
    (String(x), String(y)) => x == y
    (Array(x), Array(y)) => {
      if x.length() != y.length() {
        return false
      }
      for i in 0..<x.length() {
        if !same(x[i], y[i]) {
          return false
        }
      }
      true
    }
    (Object(x), Object(y)) => {
      if x.length() != y.length() {
        return false
      }
      for name, held in x {
        match y.get(name) {
          Some(other) => if !same(held, other) { return false }
          None => return false
        }
      }
      true
    }
    _ => false
  }
}

///|
test "the reference implementation's encodings, byte for byte" {
  // A table that lost rows would still pass the rows it kept.
  assert_eq(vectors.length(), 32)
  for (text, encoded) in vectors {
    let value = @json.loads(text)
    let bytes = @hex.decode(encoded[:])
    assert_eq(@cbor.dump(value), bytes)
  }
}

///|
test "and back to the same tree" {
  for (text, encoded) in vectors {
    let value = @json.loads(text)
    let decoded = @cbor.load(@hex.decode(encoded[:])[:])
    if !same(decoded, value) {
      fail("\{text} came back as \{@json.dumps(decoded)}")
    }
  }
}
