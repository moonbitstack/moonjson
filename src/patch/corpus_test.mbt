  (
    "Move to same location has no effect", "{\"foo\":1}", "[{\"op\":\"move\",\"from\":\"/foo\",\"path\":\"/foo\"}]",
    "{\"foo\":1}", true,
  ),
  (
    "unnamed", "{\"foo\":1,\"baz\":[{\"qux\":\"hello\"}]}", "[{\"op\":\"move\",\"from\":\"/foo\",\"path\":\"/bar\"}]",
    "{\"bar\":1,\"baz\":[{\"qux\":\"hello\"}]}", true,
  ),
  (
    "unnamed", "{\"baz\":[{\"qux\":\"hello\"}],\"bar\":1}", "[{\"op\":\"move\",\"from\":\"/baz/0/qux\",\"path\":\"/baz/1\"}]",
    "{\"bar\":1,\"baz\":[{},\"hello\"]}", true,
  ),
  (
    "unnamed", "{\"baz\":[{\"qux\":\"hello\"}],\"bar\":1}", "[{\"op\":\"copy\",\"from\":\"/baz/0\",\"path\":\"/boo\"}]",
    "{\"bar\":1,\"baz\":[{\"qux\":\"hello\"}],\"boo\":{\"qux\":\"hello\"}}", true,
  ),
  (
    "replacing the root of the document is possible with add", "{\"foo\":\"bar\"}",
    "[{\"op\":\"add\",\"path\":\"\",\"value\":{\"baz\":\"qux\"}}]", "{\"baz\":\"qux\"}",
    true,
  ),
  (
    "Adding to \"/-\" adds to the end of the array", "[1,2]", "[{\"op\":\"add\",\"path\":\"/-\",\"value\":{\"foo\":[\"bar\",\"baz\"]}}]",
    "[1,2,{\"foo\":[\"bar\",\"baz\"]}]", true,
