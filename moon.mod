name = "moonbitstack/moonjson"

version = "0.4.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonjson"

license = "Apache-2.0"

keywords = [
  "json",
  "json5",
  "jsonc",
  "jsonlines",
  "ndjson",
  "json-pointer",
  "parser",
  "moonbit",
]

description = "moonjson — the JSON family for MoonBit: RFC 8259 JSON, JSONC, JSON5 and JSON Lines over one data model, with JSON Pointer, and failures that name the line and column."

preferred_target = "wasm-gc"
