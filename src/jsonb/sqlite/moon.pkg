// SQLite's jsonb binary encoding: https://www.sqlite.org/jsonb.html
//
// jsonb is JSON's data model with one addition, a byte string, so a SQLite blob
// reads into the same tree the rest of this family already understands, and what
// the tree cannot hold outright is carried in the markers documented on `load`.
import {
  "moonbitstack/moonjson",
  "moonbitlang/core/double",
  "moonbitlang/core/encoding/hex",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
}

import {
  "moonbitstack/moonjson/json",
} for "test"
