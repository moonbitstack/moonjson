  ),
  (
    "test move with bad number should fail", "{\"foo\":1,\"baz\":[1,2,3,4]}", "[{\"op\":\"move\",\"from\":\"/baz/1e0\",\"path\":\"/foo\"}]",
    "", false,
  ),
  (
    "test add with bad number should fail", "[\"foo\",\"sil\"]", "[{\"op\":\"add\",\"path\":\"/1e0\",\"value\":\"bar\"}]",
    "", false,
  ),
  (
    "missing 'path' parameter", "{}", "[{\"op\":\"add\",\"value\":\"bar\"}]", "",
    false,
  ),
  (
    "'path' parameter with null value", "{}", "[{\"op\":\"add\",\"path\":null,\"value\":\"bar\"}]",
    "", false,
  ),
  (
    "invalid JSON Pointer token", "{}", "[{\"op\":\"add\",\"path\":\"foo\",\"value\":\"bar\"}]",
    "", false,
  ),
  (
    "missing 'value' parameter to add", "[1]", "[{\"op\":\"add\",\"path\":\"/-\"}]",
    "", false,
  ),
  (
    "missing 'value' parameter to replace", "[1]", "[{\"op\":\"replace\",\"path\":\"/0\"}]",
    "", false,
  ),
  (
    "missing 'value' parameter to test", "[null]", "[{\"op\":\"test\",\"path\":\"/0\"}]",
    "", false,
  ),
  (
    "missing value parameter to test - where undef is falsy", "[false]", "[{\"op\":\"test\",\"path\":\"/0\"}]",
    "", false,
  ),
  (
    "missing from parameter to copy", "[1]", "[{\"op\":\"copy\",\"path\":\"/-\"}]",
    "", false,
  ),
  (
    "missing from location to copy", "{\"foo\":1}", "[{\"op\":\"copy\",\"from\":\"/bar\",\"path\":\"/foo\"}]",
    "", false,
  ),
  (
    "missing from parameter to move", "{\"foo\":1}", "[{\"op\":\"move\",\"path\":\"\"}]",
    "", false,
  ),
  (
    "missing from location to move", "{\"foo\":1}", "[{\"op\":\"move\",\"from\":\"/bar\",\"path\":\"/foo\"}]",
    "", false,
  ),
  (
    "unrecognized op should fail", "{\"foo\":1}", "[{\"op\":\"spam\",\"path\":\"/foo\",\"value\":1}]",
    "", false,
  ),
  (
    "test with bad array number that has leading zeros", "[\"foo\",\"bar\"]", "[{\"op\":\"test\",\"path\":\"/00\",\"value\":\"foo\"}]",
    "", false,
  ),
  (
    "test with bad array number that has leading zeros", "[\"foo\",\"bar\"]", "[{\"op\":\"test\",\"path\":\"/01\",\"value\":\"bar\"}]",
    "", false,
  ),
  (
    "Removing nonexistent field", "{\"foo\":\"bar\"}", "[{\"op\":\"remove\",\"path\":\"/baz\"}]",
    "", false,
  ),
  (
    "Removing deep nonexistent path", "{\"foo\":\"bar\"}", "[{\"op\":\"remove\",\"path\":\"/missing1/missing2\"}]",
    "", false,
  ),
  (
    "Removing nonexistent index", "[\"foo\",\"bar\"]", "[{\"op\":\"remove\",\"path\":\"/2\"}]",
    "", false,
  ),
  (
    "Patch with different capitalisation than doc", "{\"foo\":\"bar\"}", "[{\"op\":\"add\",\"path\":\"/FOO\",\"value\":\"BAR\"}]",
    "{\"FOO\":\"BAR\",\"foo\":\"bar\"}", true,
  ),
  (
    "test copy object then change destination", "{\"foo\":{\"bar\":{\"baz\":[{\"boo\":\"net\"}]}}}",
    "[{\"op\":\"copy\",\"from\":\"/foo\",\"path\":\"/bak\"},{\"op\":\"replace\",\"path\":\"/bak/bar/baz/0/boo\",\"value\":\"qux\"}]",
    "{\"bak\":{\"bar\":{\"baz\":[{\"boo\":\"qux\"}]}},\"foo\":{\"bar\":{\"baz\":[{\"boo\":\"net\"}]}}}",
    true,
  ),
  (
    "test copy object then change source", "{\"foo\":{\"bar\":{\"baz\":[{\"boo\":\"net\"}]}}}",
    "[{\"op\":\"copy\",\"from\":\"/foo\",\"path\":\"/bak\"},{\"op\":\"replace\",\"path\":\"/foo/bar/baz/0/boo\",\"value\":\"qux\"}]",
    "{\"bak\":{\"bar\":{\"baz\":[{\"boo\":\"net\"}]}},\"foo\":{\"bar\":{\"baz\":[{\"boo\":\"qux\"}]}}}",
    true,
  ),
]

///|
/// Every case, applied: the document that results, or the refusal the corpus
/// asks for. A patch is all or nothing, so an operation that fails leaves the
/// target as it was, which is what the cases that expect a refusal are worth
/// checking for.
test "the json-patch-tests corpus" {
  for row in cases {
    let (name, doc, patch, expected, applies) = row
    let outcome = Ok(@patch.apply(@json.loads(doc[:]), @patch.loads(patch[:]))) catch {
      e => Err(e)
    }
    match outcome {
      Ok(result) =>
        if !applies {
          fail("\{name}: the patch was applied, and the corpus says it fails")
        } else {
          assert_eq(@json.dumps(result, sort=true), expected)
        }
      Err(_) =>
        if applies {
          fail("\{name}: the patch was refused, and the corpus says it applies")
        }
    }
  }
}
