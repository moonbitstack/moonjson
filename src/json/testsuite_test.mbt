///|
/// The files of `test_transform`: values that implementations disagree about.
/// They are not verdicts but round trips — read one, write it, read it again —
/// and the only wrong answer is to accept one and lose what was in it.
let transforming : Array[(String, String)] = [
  (
    "number_-9223372036854775808", "5b2d393232333337323033363835343737353830385d0a",
  ),
  (
    "number_-9223372036854775809", "5b2d393232333337323033363835343737353830395d0a",
  ),
  ("number_1.0", "5b312e305d0a"),
  (
    "number_1.000000000000000005", "5b312e3030303030303030303030303030303030355d0a",
  ),
  ("number_1000000000000000", "5b313030303030303030303030303030305d0a"),
  (
    "number_10000000000000000999", "5b31303030303030303030303030303030303939395d0a",
  ),
  ("number_1e-999", "5b31452d3939395d0a"),
  ("number_1e6", "5b3145365d0a"),
  ("number_9223372036854775807", "5b393232333337323033363835343737353830375d0a"),
  ("number_9223372036854775808", "5b393232333337323033363835343737353830385d0a"),
  ("object_key_nfc_nfd", "7b22c3a9223a224e4643222c2265cc81223a224e4644227d"),
  ("object_key_nfd_nfc", "7b2265cc81223a224e4644222c22c3a9223a224e4643227d"),
  ("object_same_key_different_values", "7b2261223a312c2261223a327d"),
  ("object_same_key_same_value", "7b2261223a312c2261223a317d"),
  ("object_same_key_unclear_values", "7b2261223a302c202261223a2d307d0a"),
  ("string_1_escaped_invalid_codepoint", "5b225c7544383030225d"),
  ("string_1_invalid_codepoint", "5b22eda080225d"),
  ("string_2_escaped_invalid_codepoints", "5b225c75443830305c7544383030225d"),
  ("string_2_invalid_codepoints", "5b22eda080eda080225d"),
  (
    "string_3_escaped_invalid_codepoints", "5b225c75443830305c75443830305c7544383030225d",
  ),
  ("string_3_invalid_codepoints", "5b22eda080eda080eda080225d"),
  ("string_with_escaped_NULL", "5b22415c753030303042225d"),
]

///|
/// The bytes a table row holds, as hex, because a source file is text.
fn bytes_of(encoded : String) -> Bytes raise {
  @hex.decode(encoded[:])
}

///|
/// One row of the parsing table, by name.
fn row_of(name : String) -> (String, String, Bool)? {
  for row in parsing {
    if row.0 == name {
      return Some(row)
    }
  }
  None
}

///|
test "JSONTestSuite: the y_ files are accepted and the n_ files refused" {
  let mut yes = 0
  let mut no = 0
  for (name, encoded, want) in parsing {
    if name.at(0) == 'i' {
      continue
    }
    let got = try {
      @json.load(bytes_of(encoded)[:]) |> ignore
      true
    } catch {
      _ => false
    }
    if got != want {
      fail(
        "\{name}: should have been \{if want { "accepted" } else { "refused" }}",
      )
    }
    if want {
      yes += 1
    } else {
      no += 1
    }
  }
  // A table that lost rows would still pass every row it kept.
  assert_eq(yes, 95)
  assert_eq(no, 188)
}

///|
test "JSONTestSuite: a number a double cannot hold is accepted" {
  // The ten `i_number_` files. Each one holds digits a double cannot, and each
  // one must come back out exactly as it went in.
  for
    name in [
      "i_number_double_huge_neg_exp", "i_number_huge_exp", "i_number_neg_int_huge_exp",
      "i_number_pos_double_huge_exp", "i_number_real_neg_overflow", "i_number_real_pos_overflow",
      "i_number_real_underflow", "i_number_too_big_neg_int", "i_number_too_big_pos_int",
      "i_number_very_big_negative_int",
    ] {
    match row_of(name) {
      Some((_, encoded, want)) => {
        assert_true(want)
        let bytes = bytes_of(encoded)
        let value = @json.load(bytes[:])
        assert_eq(@json.dump(value), bytes)
      }
      None => fail("\{name} is not in the table")
    }
  }
}

///|
test "JSONTestSuite: a lone surrogate, or bytes that are not UTF-8, are refused" {
  for
    name in [
      "i_object_key_lone_2nd_surrogate", "i_string_1st_surrogate_but_2nd_missing",
      "i_string_1st_valid_surrogate_2nd_invalid", "i_string_UTF8_surrogate_U+D800",
      "i_string_incomplete_surrogate_and_escape_valid", "i_string_incomplete_surrogate_pair",
      "i_string_incomplete_surrogates_escape_valid", "i_string_invalid_lonely_surrogate",
      "i_string_invalid_surrogate", "i_string_inverted_surrogates_U+1D11E", "i_string_lone_second_surrogate",
      "i_string_not_in_unicode_range", "i_string_UTF-16LE_with_BOM", "i_string_utf16BE_no_BOM",
      "i_string_utf16LE_no_BOM", "i_string_invalid_utf-8", "i_string_iso_latin_1",
      "i_string_lone_utf8_continuation_byte", "i_string_overlong_sequence_2_bytes",
      "i_string_overlong_sequence_6_bytes", "i_string_overlong_sequence_6_bytes_null",
      "i_string_truncated-utf-8",
    ] {
    match row_of(name) {
      Some((_, encoded, want)) => {
        assert_false(want)
        let refused = try {
          @json.load(bytes_of(encoded)[:]) |> ignore
          false
        } catch {
          _ => true
        }
        assert_true(refused)
      }
      None => fail("\{name} is not in the table")
    }
  }
}

///|
test "JSONTestSuite: a BOM is skipped, and five hundred levels are not too deep" {
  for
    name in [
      "i_structure_UTF-8_BOM_empty_object", "i_structure_500_nested_arrays",
    ] {
    match row_of(name) {
      Some((_, encoded, want)) => {
        assert_true(want)
        @json.load(bytes_of(encoded)[:]) |> ignore
      }
      None => fail("\{name} is not in the table")
    }
  }
}

///|
test "JSONTestSuite: every transform case round-trips or is refused twice" {
  let mut accepted = 0
  let mut refused = 0
  for (name, encoded) in transforming {
    let bytes = bytes_of(encoded)
    let first = Some(@json.load(bytes[:])) catch { _ => None }
    match first {
      None => {
        // Refused, and refused again: a value that cannot be read cannot be
        // written back as something else.
        refused += 1
        let again = try {
          @json.load(bytes[:]) |> ignore
          false
        } catch {
          _ => true
        }
        assert_true(again)
      }
      Some(value) => {
        accepted += 1
        let written = @json.dump(value)
        let again = @json.load(written[:])
        if @json.dumps(again) != @json.dumps(value) {
          fail("\{name}: came back as a different document")
        }
        assert_eq(@json.dump(again), written)
      }
    }
  }
  // The corpus is 22 files: the numbers, the duplicate names and the NUL are
  // readable; the escaped halves of surrogate pairs and the code points that
  // are not characters are not.
  assert_eq(accepted, 16)
  assert_eq(refused, 6)
}
