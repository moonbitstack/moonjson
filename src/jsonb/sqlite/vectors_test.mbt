///|
/// Two trees are the same when they mean the same document.
/// Numbers compare by value, strings and containers by content,
/// and the `$bytes` marker by its hex.
fn same(a : Json, b : Json) -> Bool {
  match (a, b) {
    (Null, Null) => true
    (True, True) => true
    (False, False) => true
    (Number(x, ..), Number(y, ..)) => x == y || (x.is_nan() && y.is_nan())
    (String(x), String(y)) => x == y
    (Array(x), Array(y)) => {
      if x.length() != y.length() {
        return false
      }
      for i in 0..<x.length() {
        if !same(x[i], y[i]) {
          return false
        }
      }
      true
    }
    (Object(x), Object(y)) => {
      if x.length() != y.length() {
        return false
      }
      for name, held in x {
        match y.get(name) {
          Some(other) => if !same(held, other) { return false }
          None => return false
        }
      }
      true
    }
    _ => false
  }
}

///|
test "the reference encoding, byte for byte" {
  for (text, encoded) in vectors {
    let value = @json.loads(text)
    let bytes = @hex.decode(encoded[:])
    assert_eq(@sqlite.dump(value), bytes)
  }
}

///|
test "and back to the same tree" {
  for (text, encoded) in vectors {
    let value = @json.loads(text)
    let decoded = @sqlite.load(@hex.decode(encoded[:])[:])
    if !same(decoded, value) {
      fail("\{text} came back as \{@json.dumps(decoded)}")
    }
  }
}
