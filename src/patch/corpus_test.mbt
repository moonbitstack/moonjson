  (
    "Adding to \"/-\" adds to the end of the array, even n levels down", "[1,2,[3,[4,5]]]",
    "[{\"op\":\"add\",\"path\":\"/2/1/-\",\"value\":{\"foo\":[\"bar\",\"baz\"]}}]",
    "[1,2,[3,[4,5,{\"foo\":[\"bar\",\"baz\"]}]]]", true,
  ),
  (
    "test remove with bad number should fail", "{\"foo\":1,\"baz\":[{\"qux\":\"hello\"}]}",
    "[{\"op\":\"remove\",\"path\":\"/baz/1e0/qux\"}]", "", false,
  ),
  (
    "test remove on array", "[1,2,3,4]", "[{\"op\":\"remove\",\"path\":\"/0\"}]",
    "[2,3,4]", true,
  ),
  (
    "test repeated removes", "[1,2,3,4]", "[{\"op\":\"remove\",\"path\":\"/1\"},{\"op\":\"remove\",\"path\":\"/2\"}]",
    "[1,3]", true,
  ),
  (
    "test remove with bad index should fail", "[1,2,3,4]", "[{\"op\":\"remove\",\"path\":\"/1e0\"}]",
    "", false,
